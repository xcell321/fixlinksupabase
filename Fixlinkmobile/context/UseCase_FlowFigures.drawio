<mxfile host="app.diagrams.net">
  <diagram name="Fig - End to End Repair Flow" id="fixlink-flow-endtoend">
    <mxGraphModel dx="500" dy="40" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="800" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="10" value="Start: customer opens repair request" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="11" value="System screens photo, address, terms" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Skill and proximity match, notify technicians" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="210" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Technician accepts?" style="shape=rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Request waits in Available feed" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="306" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="15" value="OTP generated, job dispatched" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Mutual live tracking with route and ETA" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="17" value="OTP code correct?" style="shape=rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Re-enter code" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="612" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Completed: ratings and portfolio" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="720" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="20" value="End" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="810" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="21" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="10" target="11" />
        <mxCell id="22" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="11" target="12" />
        <mxCell id="23" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="12" target="13" />
        <mxCell id="24" value="No" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="13" target="14" />
        <mxCell id="25" value="Yes" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="13" target="15" />
        <mxCell id="26" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="15" target="16" />
        <mxCell id="27" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="16" target="17" />
        <mxCell id="28" value="No" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="17" target="18" />
        <mxCell id="29" value="Yes" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="17" target="19" />
        <mxCell id="30" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="19" target="20" />
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Fig - Screening Pipeline" id="fixlink-flow-screen">
    <mxGraphModel dx="500" dy="40" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="800" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="10" value="Photo or document arrives" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="220" height="52" as="geometry" />
