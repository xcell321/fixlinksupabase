        </mxCell>
        <mxCell id="13" value="Merge into risk score 0 to 100" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="300" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Score 60 or higher?" style="shape=rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
