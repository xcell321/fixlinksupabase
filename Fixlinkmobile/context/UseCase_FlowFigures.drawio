        </mxCell>
        <mxCell id="15" value="Level low: proceed, keep score on record" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="398" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Flag level: warn technician, queue admin review" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="17" value="End" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="18" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="10" target="11" />
        <mxCell id="19" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="11" target="12" />
        <mxCell id="20" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="12" target="13" />
        <mxCell id="21" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="13" target="14" />
        <mxCell id="22" value="No" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="14" target="15" />
        <mxCell id="23" value="Yes" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="14" target="16" />
        <mxCell id="24" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="16" target="17" />
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Fig - Tracking and Privacy" id="fixlink-flow-track">
