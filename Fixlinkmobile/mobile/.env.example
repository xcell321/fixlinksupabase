# FixLink mobile environment — reference.
#
# Copy the values you need into mobile/.env. Expo inlines EXPO_PUBLIC_* at build
# time, so the regulation copy can be reworded without touching the source.

# --- API base URL ---------------------------------------------------------
# Optional. Leave unset and the app auto-detects (see services/api/apiUrls.tsx):
# web uses its own origin, native uses the host that served the JS bundle.
EXPO_PUBLIC_API_URL=

# --- Realtime presence ----------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- UAT #2: auto-suspend after a wasted technician trip ------------------
# Display mirror of the server's wait window: the technician's No-Show action
# shows a countdown until this many minutes have passed since the arrival stamp.
# Clamped to 30-60, matching the server.
EXPO_PUBLIC_CUSTOMER_NOSHOW_WAIT_MINUTES=60
# Whether the customer's cancel prompt warns that cancelling after the
# technician arrives suspends the account.
EXPO_PUBLIC_CUSTOMER_LATE_CANCEL_SUSPENDS=true

# --- UAT #4: booking regulations before the location step -----------------
# Show the strict terms modal between step 3 (appointment) and step 4 (map).
EXPO_PUBLIC_SUBMIT_TERMS_REQUIRED=true
EXPO_PUBLIC_TERMS_VERSION=2026-10-01
EXPO_PUBLIC_TERMS_TITLE=Booking regulations

# The numbers inside the regulation copy. Change these and the sentences follow.
EXPO_PUBLIC_TERMS_MIN_LEAD_DAYS=1
EXPO_PUBLIC_TERMS_CANCEL_WINDOW_HOURS=5

# Optional per-rule overrides. Leave unset to use the copy built from the two
# numbers above.
# EXPO_PUBLIC_TERMS_LEAD_LABEL=1-day rule
# EXPO_PUBLIC_TERMS_LEAD_RULE=
# EXPO_PUBLIC_TERMS_CANCEL_LABEL=5-hour rule
# EXPO_PUBLIC_TERMS_CANCEL_RULE=
# EXPO_PUBLIC_TERMS_SAME_DAY_LABEL=Same-day charge
# EXPO_PUBLIC_TERMS_SAME_DAY_RULE=

# Optional label overrides.
# EXPO_PUBLIC_TERMS_INTRO=
# EXPO_PUBLIC_TERMS_AGREE_LABEL=
# EXPO_PUBLIC_TERMS_CONTINUE_LABEL=
# EXPO_PUBLIC_TERMS_DECLINE_LABEL=
# EXPO_PUBLIC_TERMS_DECLINE_NOTICE=
