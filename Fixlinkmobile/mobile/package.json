{
  "name": "fixlinkmobile",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/checkImports.js",
    "verify": "npm run typecheck && npm run check:imports",
    "postinstall": "patch-package",
    "audit:responsive": "node scripts/responsiveAudit.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "axios": "^1.20.0",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.14",
    "expo-splash-screen": "~57.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@locator/babel-jsx": "^0.5.1",
    "@locator/runtime": "^0.5.1",
    "@types/react": "~19.2.4",
    "http-proxy-middleware": "^4.2.0",
    "patch-package": "^8.0.1",
    "react-native-dev-inspector": "^1.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
