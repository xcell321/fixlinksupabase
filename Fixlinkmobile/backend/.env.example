# FixLink backend environment — reference.
#
# Copy the values you need into backend/.env. Every UAT #2-#11 behaviour is
# driven from here; nothing is hardcoded in the source.

# --- Supabase (required) -------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# --- AI provider (text: assistant/ranking · vision: #6/#9/#10 screening) ---
# TWO independent axes. Each has its own provider, endpoint, model chain and
# keys, because the chat workload and the image workload do not have to live in
# the same place. Leave AI_VISION_PROVIDER unset and vision follows the text one.
#
#   AI_PROVIDER=gemini     -> https://generativelanguage.googleapis.com/v1beta/openai
#   AI_PROVIDER=omniroute  -> http://localhost:20128/v1   (the local gateway)
#   AI_PROVIDER=custom     -> whatever AI_BASE_URL says
#
# Keys: give a provider SEVERAL and they are tried in order, so an exhausted
# free-tier key falls through to the next instead of taking screening offline.
#   Gemini    GEMINI_API_KEY + GEMINI_API_KEY_BACKUP   (or AI_API_KEYS=a,b,c)
#   OmniRoute OMNIROUTE_API_KEY                        (or AI_API_KEYS=a,b,c)
# An axis only collects its own provider's keys.
#
# The OMNIROUTE_* names further down are the older spelling of these settings.
# They are honoured only while that axis is on OmniRoute, so pointing
# AI_PROVIDER at gemini cannot leave a stale gateway URL in play.

# --- Recommended preset: OmniRoute chat + Gemini vision -------------------
# Keeps the chatbot, repair analyzer and technician ranking on the local gateway
# while image screening goes to Gemini, which reads real photos far better.
AI_PROVIDER=omniroute
AI_MODEL=auto/best-chat
OMNIROUTE_API_KEY=

AI_VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# --- Gemini 3.x model notes -----------------------------------------------
# Gemini 3.x models THINK before answering, and the thinking tokens come out of
# AI_MAX_TOKENS. Too small a budget returns an empty answer, which is why the
# default is 2048 rather than a few hundred.
AI_VISION_MODEL=gemini-3.8-flash
# Hosted models shed load under spikes. The chain is tried in order, so a fallback
# keeps screening alive when the primary returns 503.
AI_VISION_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000
AI_VISION_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
AI_VISION_MAX_TOKENS=2048
# Keeps the thinking budget small; `low` is valid for Gemini 3. Leave unset for
# a provider that rejects unknown parameters (it is retried without it anyway).
AI_REASONING_EFFORT=low

# --- OmniRoute preset, the legacy defaults --------------------------------
# Only read while AI_PROVIDER (or AI_VISION_PROVIDER) is omniroute.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Text model: AI assistant, repair analyzer, technician ranking.
OMNIROUTE_MODEL=github/gpt-5.4-nano
OMNIROUTE_TIMEOUT_MS=15000
# Vision model: credential screening (#9) and facial verification (#10).
OMNIROUTE_VISION_MODEL=
OMNIROUTE_VISION_FALLBACK_MODELS=

# --- Login face gate (selfie vs stored face photo at sign-in) --------------
# Off unless explicitly enabled, so existing password logins keep working.
# When on and vision is unreachable, sign-in falls back to the password
# result instead of locking the user out; only a positive mismatch blocks.
REQUIRE_LOGIN_FACE=false
LOGIN_FACE_MATCH_THRESHOLD=0.5

# --- UAT #2: auto-suspend after a wasted technician trip -----------------
# The technician may only report a customer no-show after recording an arrival
# AND waiting this window. Clamped to 30-60 minutes (the UAT rule).
CUSTOMER_NOSHOW_WAIT_MINUTES=60
# Reported no-shows before the customer is suspended.
CUSTOMER_NOSHOW_LIMIT=1
CUSTOMER_NOSHOW_AUTO_SUSPEND=true
# Cancels after the technician already arrived before the customer is suspended.
CUSTOMER_LATE_CANCEL_LIMIT=1
CUSTOMER_LATE_CANCEL_AUTO_SUSPEND=true

# --- UAT #4: booking regulations before the location step ----------------
# The app gates step 3 -> step 4 with a modal; this is the same rule enforced
# server-side, so a client that skips the modal cannot create a booking.
SUBMIT_TERMS_REQUIRED=true
SUBMIT_TERMS_VERSION=2026-10-01
SUBMIT_TERMS_REJECTION=You must accept the booking regulations before submitting a repair request.

# --- UAT #6: daily request cap -------------------------------------------
MAX_REQUESTS_PER_DAY=3
DAILY_LIMIT_UTC_OFFSET_HOURS=8
DAILY_LIMIT_FREE_STATUSES=cancelled,canceled
# UAT #6 (part 2): fake / AI-generated device-photo screening.
PHOTO_SCREENING_ENABLED=true
PHOTO_AI_VISION_ENABLED=true
PHOTO_FLAG_THRESHOLD=60
PHOTO_HIGH_THRESHOLD=80
PHOTO_AI_THRESHOLD=0.6

# --- UAT #5: fake address / harassment / spam bookings -------------------
REQUEST_SAFETY_ENABLED=true
ADDRESS_MIN_LENGTH=8
ADDRESS_MIN_TOKENS=2
ADDRESS_MAX_REPEAT_RUN=4
ADDRESS_GPS_TOLERANCE_KM=5
# 'flag' (warn the technician) or 'block' (refuse the submission).
ADDRESS_ENFORCEMENT=flag
SUBMIT_COOLDOWN_SECONDS=60
SPAM_WINDOW_HOURS=24
SPAM_SIMILARITY_THRESHOLD=0.8
SPAM_MAX_MATCHES=2
MAX_BOOKINGS_PER_ADDRESS_PER_DAY=3
# Defines "today" for the address-targeting check; falls back to
# DAILY_LIMIT_UTC_OFFSET_HOURS, then 8 (PH = UTC+8).
REQUEST_SAFETY_UTC_OFFSET_HOURS=8

# --- UAT #7: technician capacity -----------------------------------------
TECHNICIAN_MAX_ACTIVE_JOBS=1
TECHNICIAN_BUSY_JOBS=3
TECHNICIAN_AT_CAPACITY_JOBS=6
# Which job statuses count as active work.
ACTIVE_JOB_STATUSES=Accepted,Confirmed,Customer Ready,In Progress

# --- UAT #8: repeat scammer ----------------------------------------------
CUSTOMER_SCAM_LIMIT=3
CUSTOMER_SCAM_AUTO_SUSPEND=true
# Statuses in which a scam report can be filed.
SCAM_REPORTABLE_STATUSES=in progress,completed

# --- UAT #11: two-way ratings --------------------------------------------
RATING_MIN=1
RATING_MAX=5
REVIEWER_ROLES=customer,technician
# UAT #11: enough negative ratings auto-suspend the customer.
NEGATIVE_RATING_MAX=2
CUSTOMER_NEGATIVE_RATING_LIMIT=3
CUSTOMER_NEGATIVE_RATING_AUTO_SUSPEND=true

# --- UAT #9 / #10: credential screening + facial verification -------------
CREDENTIAL_SCREENING_ENABLED=true
CREDENTIAL_AI_VISION_ENABLED=true
# Detection signatures (comma-separated, case-insensitive substring match).
CREDENTIAL_AI_MARKERS=midjourney,dall-e,dalle,stable diffusion,stablediffusion,comfyui,c2pa,synthid,govai,imagen,firefly,flux
CREDENTIAL_EDITOR_MARKERS=photoshop,adobe photoshop,canva,snapseed,lightroom,gimp,picsart,pixlr
# Required signup documents per role.
TECHNICIAN_REQUIRED_DOCS=facePhotoFile,governmentIdFile,certificateFile
CUSTOMER_REQUIRED_DOCS=facePhotoFile,governmentIdFile
CREDENTIAL_FACE_CHECK_ENABLED=true
CREDENTIAL_SELFIE_REQUIRED=true
CREDENTIAL_FLAG_THRESHOLD=60
CREDENTIAL_HIGH_THRESHOLD=80
CREDENTIAL_MIN_DIMENSION=300
CREDENTIAL_MIN_FILE_BYTES=20480
CREDENTIAL_FORENSIC_WEIGHT=0.4
CREDENTIAL_VISION_WEIGHT=0.6
CREDENTIAL_VISION_AI_THRESHOLD=0.6
CREDENTIAL_VISION_TAMPER_THRESHOLD=0.6
CREDENTIAL_FACE_MATCH_THRESHOLD=0.5
CREDENTIAL_LIVENESS_RISK_THRESHOLD=0.6
CREDENTIAL_VISION_MAX_BYTES=2097152
CREDENTIAL_VISION_TIMEOUT_MS=20000
